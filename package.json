{
  "name": "pingin",
  "version": "0.1.0",
  "description": "PiNGiN — a local-first pi-agent companion that appears next to your cursor",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npx vite build && electron dist/main/index.js",
    "dev": "vite",
    "dev:electron": "concurrently --kill-others-on-fail --success=first \"vite build --watch\" \"electron dist/main/index.js\"",
    "build": "tsc && vite build && electron-builder",
    "build:renderer": "vite build",
    "build:main": "tsc --project tsconfig.main.json",
    "preview": "vite preview",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build",
    "electron:dev": "vite --host",
    "electron:build": "tsc && vite build && electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "keywords": [
    "pi-agent",
    "coding-agent",
    "desktop",
    "ai-assistant"
  ],
  "author": "deejayh",
  "license": "MIT"
}
